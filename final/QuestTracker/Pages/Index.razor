@page "/"
@using QuestTracker.Data
@using QuestTracker.Services
@inject GameService Game

<h3>Eternal Quest - Demo</h3>

@if (Game.GetState().GetPlayer() == null)
{
    <p>Create a character:</p>
    <input @bind="playerName" placeholder="Name" />
    <select @bind="playerType">
        <option value="Warrior">Warrior</option>
        <option value="Mage">Mage</option>
        <option value="Rogue">Rogue</option>
    </select>
    <button @onclick="CreateCharacter">Create</button>
}
else
{
    <p>
        <b>Player:</b> @Game.GetState().GetPlayer().GetName()
        (Level @Game.GetState().GetPlayer().GetLevel(), XP @Game.GetState().GetPlayer().GetExperience())
    </p>

    <button @onclick="AddQuests">Add Sample Quests</button>
    <button @onclick="Reset">Reset</button>

    <h4>Quests</h4>
    <ul>
        @for (int i = 0; i < Game.GetState().GetQuests().Count; i++)
        {
            var q = Game.GetState().GetQuests()[i];
            <li>
                <b>@q.GetTitle()</b> - @q.GetDescription()
                <br />
                Status: @q.GetStatus()
                <br />
                <button @onclick="(() => CompleteQuest(i))">Record/Complete</button>
            </li>
        }
    </ul>
}

@code {
    private string playerName = "Hero";
    private string playerType = "Warrior";

    private void CreateCharacter()
    {
        Game.CreateCharacter(playerName, playerType);
    }

    private void AddQuests()
    {
        Game.AddSampleQuests();
    }

    private void Reset()
    {
        Game.ResetState();
    }

    private void CompleteQuest(int index)
    {
        int pts = Game.CompleteQuest(index);
        if (pts > 0)
        {
            // optionally notify user - for now simple console log
            Console.WriteLine($"Awarded {pts} XP");
        }
    }
}
